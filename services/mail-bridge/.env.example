# Copy to .env and fill in real values.
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data

# Device Bearer token — generate with: openssl rand -hex 32
DEVICE_TOKEN=change-me-to-a-long-random-token

# IMAP mailbox the bridge polls for book attachments (.epub / .txt)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USER=inbox@example.com
IMAP_PASS=secret
IMAP_FOLDER=INBOX

# How often to poll (seconds). /v1/pending also triggers an on-demand poll.
POLL_SECONDS=60

# After extracting attachments: "seen" marks \\Seen, "move" copies to PROCESSED_FOLDER then deletes.
POST_PROCESS=seen
PROCESSED_FOLDER=Processed
