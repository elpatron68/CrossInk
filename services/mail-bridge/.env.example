# Copy to .env and fill in real values.
HOST=0.0.0.0
PORT=8080
DATA_DIR=./data

# Plus-alias mailboxes: {MAIL_LOCAL_PREFIX}+{mail_local}@{MAIL_DOMAIN}
MAIL_LOCAL_PREFIX=bookbridge
MAIL_DOMAIN=hoerdle.de
MAIL_LOCAL_LENGTH=10

# Catch-all IMAP mailbox that receives all plus-alias mail
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USER=inbox@example.com
IMAP_PASS=secret
IMAP_FOLDER=INBOX

# How often to poll (seconds). /v1/pending also triggers an on-demand poll.
POLL_SECONDS=60

# After a matched message is queued: delete | move | seen
# Unknown aliases / no attachments are always deleted.
POST_PROCESS=delete
PROCESSED_FOLDER=Processed

# Delete stored blobs when the device acks a download (true/false).
DELETE_ON_ACK=true

# Pending items not downloaded within N days are purged (0 disables).
ORPHAN_RETENTION_DAYS=14
ORPHAN_CLEANUP_SECONDS=3600

# Optional Plausible Analytics on the pairing page (leave empty to disable).
# PLAUSIBLE_DOMAIN=bookbridge.hoerdle.de
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Unused accounts (never synced) older than N days are deleted (0 disables).
ACCOUNT_UNUSED_DAYS=7
# Accounts with no sync and no mail for M days are deleted (0 disables).
ACCOUNT_INACTIVE_DAYS=365

# Max POST /v1/accounts per client IP per rolling hour (0 disables).
SIGNUP_RATE_LIMIT_PER_HOUR=5
# When true (nginx Proxy Manager), client IP from X-Forwarded-For / X-Real-IP.
TRUST_PROXY=true
