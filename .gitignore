# --- PlatformIO / local toolchain (WSL builds) ---
.pio/
.pio-venv/
.platformio-core/
/compile_commands.json
/.cache/

# Generated by pioarduino when custom_sdkconfig rebuilds the framework.
/managed_components/
/.dummy/
/CMakeLists.txt
/dependencies.lock
/sdkconfig.*

# --- IDE / OS ---
.idea/
.vs/
.vscode/
.DS_Store
.history/

# --- Python ---
**/__pycache__/
*.pyc
.pytest_cache/
/.venv/

# --- Local overrides / secrets (keep *.example tracked) ---
*.local*
.env
!.env.example
!**/.env.example

# --- Generated / build outputs ---
build/
dist-publish/
lib/EpdFont/fontsrc
lib/I18n/I18nKeys.h
lib/I18n/I18nStrings.h
lib/I18n/I18nStrings.cpp
*.generated.h
lib/ScalableFont/*.generated.h
fs_/

# Font pipeline scratch
*.cpfont
lib/EpdFont/scripts/downloaded_fonts/
lib/EpdFont/scripts/instanced_fonts/
lib/EpdFont/scripts/output/

# --- Mail bridge (also has services/mail-bridge/.gitignore) ---
services/mail-bridge/.venv/
services/mail-bridge/data/

# --- Site ---
/site/node_modules/
/site/dist/
/site/.astro/
/site/public/images/
/site/public/catalog
/site/public/CNAME

# scratchpad used as release notes for next crossink version
release.md

# Claude Code: share project skills with the team, keep local agent state
# (worktrees, scheduled-task locks, settings.local, scout CLEANUP.md) out.
.claude/*
!.claude/skills/
